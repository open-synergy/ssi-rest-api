<odoo noupdate="1">
    <!-- Registered by record XML, same mechanism ssi_rest_api's own
         basic/bearer schemes use, never Python import-time registration.
         sequence=30 runs after bearer (10) and basic (20), already seeded
         by ssi_rest_api itself; relative order among active schemes has
         no functional effect here (each scheme's own _rest_auth_extract
         only ever looks at its own, distinct header). -->
    <record id="ssi_rest_auth_scheme_apikey" model="ssi_rest_auth_scheme">
        <field name="name">API Key</field>
        <field name="code">apikey</field>
        <field name="provider_model">ssi_rest_auth_apikey</field>
        <field name="sequence">30</field>
    </record>
</odoo>
