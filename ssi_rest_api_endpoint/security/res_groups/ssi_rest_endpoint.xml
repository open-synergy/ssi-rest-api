<odoo>
    <!-- Odoo 19 replaced res.groups.category_id with res.groups.privilege_id
         (res.groups.privilege.category_id) and res.groups.users with
         res.groups.user_ids; see base/models/res_groups.py and
         base/models/res_groups_privilege.py. -->
    <record id="res_groups_privilege_ssi_rest_endpoint" model="res.groups.privilege">
        <field name="name">REST Custom Endpoint</field>
        <field name="category_id" ref="ssi_rest_api.ssi_rest_api_module_category" />
    </record>

    <record id="ssi_rest_endpoint_group" model="res.groups">
        <field name="name">Configurator</field>
        <field name="privilege_id" ref="res_groups_privilege_ssi_rest_endpoint" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
