msgstr ""

#. module: ssi_rest_api_auth_apikey
#: model:ir.model,name:ssi_rest_api_auth_apikey.model_ssi_rest_auth_apikey
msgid "REST Authentication Provider - Scoped API Key"
msgstr ""

#. module: ssi_rest_api_auth_apikey
#: model:ir.model.fields,help:ssi_rest_api_auth_apikey.field_ssi_rest_api_key__key_hash
msgid ""
"Salted hash of the full raw key (passlib pbkdf2_sha512). The raw key itself "
"is never stored anywhere; it only ever exists as the return value of "
"_generate_new_key(), shown to the caller once."
msgstr ""

#. module: ssi_rest_api_auth_apikey
#: model:ir.model.fields,help:ssi_rest_api_auth_apikey.field_ssi_rest_api_key__last_used_date
msgid ""
"Timestamp of this key's last successful authentication. Updated through a "
"cursor independent of the authenticating request's own transaction (see "
"_touch_last_used_date), never through that request's own env.cr."
msgstr ""

