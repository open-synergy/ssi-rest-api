<odoo>
    <!-- Every internal user gets full CRUD at the ACL level; ownership
         is enforced by ir.rule (security/ir_rule/ssi_rest_api_key.xml),
         not here: a plain user must be able to create and manage their
         OWN keys, not merely read them. -->
    <record id="ssi_rest_api_key_all_access" model="ir.model.access">
        <field name="name">ssi_rest_api_key - all</field>
        <field name="model_id" ref="model_ssi_rest_api_key" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
