<odoo noupdate="1">
    <!-- Registered by record XML, same mechanism ssi_rest_api's own
         basic/bearer schemes and ssi_rest_api_auth_apikey's own scheme
         use, never Python import-time registration. sequence=40 runs
         after bearer (10), basic (20) and apikey (30), already seeded by
         their own modules; relative order among active schemes only
         matters when more than one extracts a credential from the same
         request, which _auth_method_ssi_rest rejects as
         400 multiple_credentials regardless of order (see
         models/ssi_rest_auth_jwt.py's module docstring for the one
         Authorization-header interaction this scheme has with the
         built-in bearer scheme). -->
    <record id="ssi_rest_auth_scheme_jwt" model="ssi_rest_auth_scheme">
        <field name="name">JWT</field>
        <field name="code">jwt</field>
        <field name="provider_model">ssi_rest_auth_jwt</field>
        <field name="sequence">40</field>
    </record>
</odoo>
