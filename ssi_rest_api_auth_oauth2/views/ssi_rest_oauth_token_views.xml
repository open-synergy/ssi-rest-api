<odoo>
    <record id="ssi_rest_oauth_token_view_search" model="ir.ui.view">
        <field name="name">ssi_rest_oauth_token - search</field>
        <field name="model">ssi_rest_oauth_token</field>
        <field name="arch" type="xml">
            <search>
                <field name="client_id" />
                <field name="user_id" />
                <field name="token_index" />
                <filter
                    name="dom_not_revoked"
                    string="Not Revoked"
                    domain="[('revoked', '=', False)]"
                />
                <filter
                    name="dom_revoked"
                    string="Revoked"
                    domain="[('revoked', '=', True)]"
                />
                <group name="group_by">
                    <filter
                        name="group_by_client"
                        string="Client"
                        context="{'group_by': 'client_id'}"
                    />
                    <filter
                        name="group_by_token_type"
                        string="Type"
                        context="{'group_by': 'token_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="ssi_rest_oauth_token_view_list" model="ir.ui.view">
        <field name="name">ssi_rest_oauth_token - list</field>
        <field name="model">ssi_rest_oauth_token</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="client_id" />
                <field name="user_id" />
                <field name="token_type" />
                <field name="token_index" />
                <field name="scope" />
                <field name="expiration_date" />
                <field name="revoked" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="ssi_rest_oauth_token_view_form" model="ir.ui.view">
        <field name="name">ssi_rest_oauth_token - form</field>
        <field name="model">ssi_rest_oauth_token</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button
                        name="action_revoke"
                        type="object"
                        string="Revoke"
                        class="oe_highlight"
                        invisible="revoked"
                    />
                </header>
                <sheet>
                    <group name="group_1">
                        <field name="client_id" />
                        <field name="user_id" />
                        <field name="token_type" />
                        <field name="token_index" readonly="1" />
                        <field name="scope" />
                        <field name="expiration_date" />
                        <field name="revoked" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ssi_rest_oauth_token_action" model="ir.actions.act_window">
        <field name="name">OAuth2 Token</field>
        <field name="res_model">ssi_rest_oauth_token</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="ssi_rest_oauth_token_menu"
        parent="ssi_rest_api.menu_ssi_rest_api_configuration"
        action="ssi_rest_oauth_token_action"
        sequence="52"
    />
</odoo>
