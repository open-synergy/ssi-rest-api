<odoo>
    <record id="ssi_rest_oauth_scope_all_access" model="ir.model.access">
        <field name="name">ssi_rest_oauth_scope - all</field>
        <field name="model_id" ref="model_ssi_rest_oauth_scope" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
