<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings - form - ssi_rest_api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="after">
                <block title="REST API" name="ssi_rest_api_setting_container">
                    <setting
                        id="ssi_rest_api_expose_traceback_setting"
                        string="Expose Traceback"
                        help="Include the Python traceback in the REST error envelope for base.group_system callers. Keep disabled in production."
                    >
                        <field name="ssi_rest_api_expose_traceback" />
                    </setting>
                    <setting
                        id="ssi_rest_api_page_size_setting"
                        string="Page Size"
                        help="Default and maximum number of records returned per page on list requests."
                    >
                        <field name="ssi_rest_api_default_page_size" />
                        <field name="ssi_rest_api_max_page_size" />
                    </setting>
                    <setting
                        id="ssi_rest_api_cors_origins_setting"
                        string="CORS Origins"
                        help="Comma-separated list of allowed CORS origins. Empty means CORS headers are not emitted."
                    >
                        <field name="ssi_rest_api_cors_origins" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
