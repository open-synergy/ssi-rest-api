<odoo>
    <record id="ssi_rest_endpoint_view_search" model="ir.ui.view">
        <field name="name">ssi_rest_endpoint - search</field>
        <field name="model">ssi_rest_endpoint</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="ssi_rest_endpoint_view_list" model="ir.ui.view">
        <field name="name">ssi_rest_endpoint - list</field>
        <field name="model">ssi_rest_endpoint</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="path" />
                    <field name="http_method" />
                    <field name="handler_type" />
                    <field name="is_readonly" widget="boolean_toggle" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="ssi_rest_endpoint_view_form" model="ir.ui.view">
        <field name="name">ssi_rest_endpoint - form</field>
        <field name="model">ssi_rest_endpoint</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="endpoint" string="Endpoint">
                        <group name="endpoint_group_1" string="Route">
                            <field name="path" />
                            <field name="http_method" />
                            <field name="is_readonly" widget="boolean_toggle" />
                        </group>
                        <group name="endpoint_group_2" string="Handler">
                            <field name="handler_type" />
                            <field
                                name="model_id"
                                invisible="handler_type != 'model_method'"
                            />
                            <field
                                name="method_name"
                                invisible="handler_type != 'model_method'"
                            />
                            <field
                                name="server_action_id"
                                invisible="handler_type != 'server_action'"
                            />
                        </group>
                        <group name="endpoint_group_3" string="Access">
                            <field name="profile_ids" widget="many2many_tags" />
                        </group>
                        <group name="endpoint_group_4" string="Schema" colspan="4">
                            <field name="input_schema" colspan="4" />
                            <field name="output_schema" colspan="4" />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="ssi_rest_endpoint_action" model="ir.actions.act_window">
        <field name="name">REST Custom Endpoint</field>
        <field name="res_model">ssi_rest_endpoint</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="ssi_rest_endpoint_menu"
        parent="ssi_rest_api.menu_ssi_rest_api_configuration"
        action="ssi_rest_endpoint_action"
        groups="base.group_system"
    />
</odoo>
