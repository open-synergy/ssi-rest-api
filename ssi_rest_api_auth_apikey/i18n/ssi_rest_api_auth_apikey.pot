"expiration_date has passed is rejected as an invalid credential, exactly "
"like a wrong key."
msgstr ""

#. module: ssi_rest_api_auth_apikey
#: model:ir.model.fields,help:ssi_rest_api_auth_apikey.field_ssi_rest_api_key__key_index
msgid ""
"Plaintext prefix of the generated raw key, used to look up a candidate row "
"quickly (indexed) before verifying the full key against key_hash. Not secret"
" on its own: knowing this prefix alone never authenticates a request."
msgstr ""

#. module: ssi_rest_api_auth_apikey
#: model:ir.model,name:ssi_rest_api_auth_apikey.model_ssi_rest_api_key
