<odoo>
    <!-- Every internal user can read -->
    <record id="ssi_rest_auth_scheme_all_access" model="ir.model.access">
        <field name="name">ssi_rest_auth_scheme - all</field>
        <field name="model_id" ref="model_ssi_rest_auth_scheme" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <!-- Configurator has full access -->
    <record id="ssi_rest_auth_scheme_user_access" model="ir.model.access">
        <field name="name">ssi_rest_auth_scheme - user</field>
        <field name="model_id" ref="model_ssi_rest_auth_scheme" />
        <field name="group_id" ref="ssi_rest_auth_scheme_group" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
